{
  "name": "wonderweave-expo",
  "version": "0.2.5",
  "main": "index.ts",
  "private": true,
  "description": "Wonderweave Android shell \u00e2\u20ac\u201d packages the Next.js static game into a local WebView.",
  "scripts": {
    "game:build": "node scripts/sync-web-bundle.mjs --build-only",
    "game:sync": "node scripts/sync-web-bundle.mjs",
    "expo:sync-web": "node scripts/sync-web-bundle.mjs",
    "expo:start": "expo start --dev-client",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --platform android --non-interactive",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:whitebox": "node --test \"tests/white-box/**/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/**/*.test.mjs\"",
    "test:smoke": "node --test \"tests/smoke/**/*.test.mjs\"",
    "test:blackbox": "node --test \"tests/black-box/**/*.test.mjs\"",
    "test:e2e": "node scripts/android-e2e.mjs",
    "validate:webbundle": "node scripts/validate-web-bundle.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.36",
    "expo-build-properties": "~1.0.10",
    "expo-haptics": "~15.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-navigation-bar": "~5.0.10",
    "expo-screen-orientation": "~9.0.9",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}
