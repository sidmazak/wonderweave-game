{
  "name": "wonderweave",
  "version": "1.0.0",
  "private": true,
  "description": "Wonderweave — cozy offline match-3 puzzle adventure (Next.js static export + Expo Android).",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "game:build": "next build",
    "game:sync": "npm run game:sync --prefix \"Expo app\"",
    "expo:sync-web": "npm run game:sync --prefix \"Expo app\"",
    "expo:start": "npm run expo:start --prefix \"Expo app\"",
    "start": "npx --yes serve out -p 3000",
    "lint": "eslint .",
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "asset-eraser": "node tools/asset-eraser/server.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "sharp": "^0.34.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "5.9.3"
  }
}
